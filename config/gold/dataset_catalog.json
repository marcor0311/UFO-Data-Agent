  "limitations": [
    {"code": "reports_not_facts", "text": "Cada fila es un informe registrado por una fuente, no un hecho verificado ni un avistamiento confirmado. Coincidir con Bronze no prueba que el relato sea verdadero."},
    {"code": "pending_duplicates", "text": "Algunos informes tienen coincidencias por revisar con otros. No están confirmados como duplicados: cada uno cuenta como un informe."},
    {"code": "confirmed_events_only", "text": "Los eventos existen solo para los grupos de duplicados confirmados por coincidencia exacta. Los informes únicos y los candidatos pendientes no son eventos."},
    {"code": "eligibility_calendar", "text": "Solo informes con fecha apta para calendario; quedan fuera fechas calificadas, intervalos, faltantes, inválidas y en revisión."},
    {"code": "eligibility_month", "text": "Solo informes con mes fiable; quedan fuera las fechas de solo año y las 01-01 de fuentes con exceso de ese marcador."},
    {"code": "eligibility_day", "text": "Solo informes con día fiable; quedan fuera los días 01 y 15 de las fuentes con exceso de marcadores, además de las fechas de mes o año."},
    {"code": "eligibility_hour", "text": "Solo informes con hora de minuto o mejor y fecha apta. Es hora local declarada sin zona horaria; muchas horas están redondeadas a la hora en punto."},
    {"code": "eligibility_map", "text": "Solo informes con coordenadas completas, en rango y fuera de cuarentena. Una coordenada puede ser el centro de una ciudad, no el lugar exacto del testigo."},
    {"code": "eligibility_country", "text": "Solo informes con país canónico consistente; los países contradictorios, históricos o no reconocidos quedan fuera."},
    {"code": "eligibility_nuclear_proximity", "text": "La distancia es a la instalación más cercana del catálogo local de Silver (bases, laboratorios y polígonos), no a todas las instalaciones del mundo. Cercanía no implica relación."},
    {"code": "day_placeholders", "text": "Algunas fuentes usan días marcadores (01, 15 o 01-01) cuando no conocen la fecha exacta; Silver reduce la precisión de esos informes en lugar de inventar o borrar fechas."},
    {"code": "model_scores", "text": "Sentimiento, emociones, hoax_likelihood y quality_score son salidas de modelos o heurísticas heredadas del origen, no hechos ni verificaciones. No se presentan como verdad."},
    {"code": "source_bias", "text": "La cobertura depende de cada fuente y época: predominan los informes de Estados Unidos y de los años con sistemas de reporte en línea; NUFORC aparece en UFOCAT y en UPDB."},
    {"code": "external_evidence", "text": "Parte de las coordenadas, países u horas procede del catálogo fijado de UFO-search y no de Bronze (uses_external_evidence=1)."}
  ]
}
